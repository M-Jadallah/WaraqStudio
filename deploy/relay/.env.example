# For plain Docker Compose only: copy to an untracked .env at repository root
# or supply --env-file explicitly. Coolify generates SERVICE_HEX_64_WARAQDB;
# do not paste the placeholder below into Coolify or commit a real secret.
# PUBLIC_BASE_URL is optional for this domain; Compose has this same default.
# Override with an HTTPS origin only, without port/path/trailing slash.
PUBLIC_BASE_URL=https://waraqstudio.jadallah.work
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Both services reuse the same 64-hex secret; DATABASE_URL is assembled for you.
SERVICE_HEX_64_WARAQDB=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Existing deployments: preserve the current DB password under this new name
# before upgrading. Do not regenerate a secret while retaining an old volume.
